{
    // ─── Required secrets (set out-of-band, NEVER commit) ───────────────────────
    // wrangler secret put APP_ENCRYPTION_KEY           (decrypts stored Vimeo creds)
    // wrangler secret put ADMIN_BOOTSTRAP_TOKEN        (admin bootstrap login)
    // wrangler secret put VIMEO_ACCESS_TOKEN          (optional; falls back to encrypted DB value)
    //
    // Data: Cloudflare D1 (binding DB) + R2 (binding MEDIA_BUCKET) — see blocks below.
    // Migrated off Supabase 2026-06-04; no SUPABASE_* / NEXT_PUBLIC_SUPABASE_* needed.
    //
    // Per-environment dashboard env vars (NOT secrets, but per-env config):
    //   Set in Cloudflare dashboard > Workers & Pages > dig-sign > Settings > Variables
    //   NEXT_PUBLIC_APP_BASE_URL      (e.g. https://digsign.diegodella.ar) — build-time inlined
    // ────────────────────────────────────────────────────────────────────────────
    "name": "dig-sign",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-04-15",
    "compatibility_flags": ["nodejs_compat"],
    // Preserve dashboard env vars + secrets on every deploy, regardless of
    // CLI flag or CF Workers Builds dashboard build command. Defensive guard
    // against `wrangler deploy` raw wiping dashboard variables.
    "keep_vars": true,
    // ─── Named env blocks ────────────────────────────────────────────────────────
    // IMPORTANT: Named envs (--env dev / --env prod) do NOT inherit top-level
    // bindings. Every binding used by a named env MUST be re-declared inside
    // its env block. The top-level bindings below serve `wrangler dev` (no
    // --env flag) and the bare `deploy` / `cf:deploy` scripts.
    // ────────────────────────────────────────────────────────────────────────────
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "routes": [
        {
            "pattern": "digsign.diegodella.ar",
            "custom_domain": true,
        },
    ],
    // ─── Slide-data KV cache (Phase E1) ─────────────────────────────────────────
    "kv_namespaces": [
        {
            "binding": "SLIDE_DATA_KV",
            "id": "23efcaa8fddf46a5b33e0acb6d8fcc6b",
            "preview_id": "1592b3ff06a44ae9b3aee486420382eb",
        },
    ],
    // ─── D1 database ─────────────────────────────────────────────────────────────
    // Run `wrangler d1 create dig-sign-db` to provision and replace the
    // PLACEHOLDER below with the real database_id printed by that command.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "dig-sign-db",
            "database_id": "59b0524c-5cc6-41cb-9536-bffd580c3a61",
            "migrations_dir": "./drizzle",
        },
    ],
    // ─── R2 media storage ────────────────────────────────────────────────────────
    // Run `wrangler r2 bucket create dig-sign-media` to provision.
    "r2_buckets": [
        {
            "binding": "MEDIA_BUCKET",
            "bucket_name": "dig-sign-media",
        },
    ],
    // ─── Named env: dev ──────────────────────────────────────────────────────────
    // Used by: npm run deploy:dev  →  wrangler deploy --keep-vars --env dev
    // Run `wrangler d1 create dig-sign-db-dev` and replace PLACEHOLDER_DEV_D1_ID.
    // Run `wrangler r2 bucket create dig-sign-media-dev` for the dev R2 bucket.
    "env": {
        "dev": {
            "name": "dig-sign-dev",
            "keep_vars": true,
            "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS",
            },
            "kv_namespaces": [
                {
                    "binding": "SLIDE_DATA_KV",
                    "id": "9f83185620c54181a75c0462fd906193",
                    "preview_id": "1592b3ff06a44ae9b3aee486420382eb",
                },
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "dig-sign-db-dev",
                    "database_id": "PLACEHOLDER_DEV_D1_ID",
                    "migrations_dir": "./drizzle",
                },
            ],
            "r2_buckets": [
                {
                    "binding": "MEDIA_BUCKET",
                    "bucket_name": "dig-sign-media-dev",
                },
            ],
        },
        // ─── Named env: prod ─────────────────────────────────────────────────────
        // Used by: npm run deploy:prod  →  wrangler deploy --keep-vars --env prod
        // Shares the same D1 + R2 ids as the top-level (production) bindings.
        // Replace PLACEHOLDER_PROD_D1_ID once `wrangler d1 create dig-sign-db` runs.
        "prod": {
            "name": "dig-sign",
            "keep_vars": true,
            "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS",
            },
            "routes": [
                {
                    "pattern": "digsign.diegodella.ar",
                    "custom_domain": true,
                },
            ],
            "kv_namespaces": [
                {
                    "binding": "SLIDE_DATA_KV",
                    "id": "23efcaa8fddf46a5b33e0acb6d8fcc6b",
                    "preview_id": "1592b3ff06a44ae9b3aee486420382eb",
                },
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "dig-sign-db",
                    "database_id": "59b0524c-5cc6-41cb-9536-bffd580c3a61",
                    "migrations_dir": "./drizzle",
                },
            ],
            "r2_buckets": [
                {
                    "binding": "MEDIA_BUCKET",
                    "bucket_name": "dig-sign-media",
                },
            ],
        },
    },
}
